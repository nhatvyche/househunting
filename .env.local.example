# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (for auth redirects — use http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared Gmail inbox shown in Settings
NEXT_PUBLIC_INBOX_EMAIL=househunting.betatest@gmail.com

# Secret key for Gmail Apps Script → /api/ingest (generate a random string)
INGEST_API_KEY=change-me-to-a-long-random-string

# Optional: Claude API for parsing listing URLs (same approach as current system)
ANTHROPIC_API_KEY=
